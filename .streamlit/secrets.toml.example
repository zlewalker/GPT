# Copy to secrets.toml locally or paste into Streamlit Cloud > Settings > Secrets.
# Get the exact Session pooler URL from Supabase > Connect; encode password URL characters.
DATABASE_URL = "postgresql://ROLE.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres?sslmode=require"
DATABASE_SCHEMA = "votes_app"
ADMIN_PIN = "REPLACE_WITH_A_STRONG_ADMIN_SECRET"
